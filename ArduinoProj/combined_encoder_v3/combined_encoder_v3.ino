// =====================================================
// PRINT ROTATION RESULT
// =====================================================
void printRotationResult() {
  bool gyroBiasStable = gyroResidualBiasValid
                     && fabs(finalGyroZ) <= MAX_VALID_RESIDUAL_BIAS;
  bool gyroDataReliable = gyroReadFailuresAtStop <= 20
                       && gyroBusRecoveriesAtStop <= 2
                       && gyroInvalidSamplesAtStop <= 5
                       && gyroBiasStable;
  float correctedYawAtStop = yawAtStopCommand
                           - finalGyroZ
                           * (gyroIntegrationTimeMs / 1000.0f);
  float correctedFinalYaw = finalYaw
                          - finalGyroZ
                          * ((gyroIntegrationTimeMs + SETTLE_TIME_MS)
                             / 1000.0f);
  float expectedGyroYaw = RIGHT_TURN_GYRO_SIGN
                        * commandedRotationDirection
                        * commandedRotationDeg;
  float finalRotationProgress = RIGHT_TURN_GYRO_SIGN
                              * commandedRotationDirection
                              * correctedFinalYaw;
  float finalAngleError = finalRotationProgress - commandedRotationDeg;
  float measuredFinalAngle = fabs(correctedFinalYaw);
  float angleScale = measuredFinalAngle > 1.0f
                   ? commandedRotationDeg / measuredFinalAngle
                   : 1.0f;
  float recommendedLeftTicks = leftAtStopCommand * angleScale;
  float recommendedRightTicks = rightAtStopCommand * angleScale;
  float allowedAngleError = max(2.0f, commandedRotationDeg * 0.01f);
  bool rotationCalibrationReady = gyroDataReliable
                               && !runTimedOut
                               && !rotationAbortedGyro
                               && !rotationAbortedWrongDirection
                               && !rotationAbortedWheelStart
                               && !rotationAbortedWheelMismatch
                               && fabs(finalAngleError) <= allowedAngleError;
  bool encoderTargetReached = leftAtStopCommand >= rotationTargetLeftTicks
                           && rightAtStopCommand >= rotationTargetRightTicks;

  Serial.println("======= ROTATION TEST RESULT =======");
  Serial.print("Firmware             : ");
  Serial.println(FIRMWARE_REVISION);
  Serial.print("Control Mode         : ");
  Serial.println(rotationEncoderReplayMode
               ? "ENCODER-ONLY ROTATION (GYRO LOG ONLY)"
               : "GYRO 360 STOP + ENCODER COUNT");
  Serial.print("Direction            : ");
  Serial.println(commandedRotationDirection > 0 ? "RIGHT" : "LEFT");
  Serial.print("Target Angle         : ");
  Serial.print(commandedRotationDeg, 2);
  Serial.println(" deg");
  Serial.print("Expected Gyro Yaw    : ");
  Serial.print(expectedGyroYaw, 2);
  Serial.println(" deg");
  if (rotationEncoderReplayMode) {
    Serial.print("Encoder Target L/R   : ");
    Serial.print(rotationTargetLeftTicks);
    Serial.print(" / ");
    Serial.println(rotationTargetRightTicks);
    Serial.print("Target Wheel Speed   : ");
    Serial.print(commandedSpeed, 2);
    Serial.println(" cm/s");
  }
  Serial.print("Run time             : ");
  Serial.print(runTimeMs);
  Serial.println(" ms");
  Serial.print("Run Timed Out        : ");
  Serial.println(runTimedOut ? "YES" : "NO");
  Serial.print("Rotation Status      : ");
  if (rotationAbortedGyro) {
    Serial.println("ABORTED - GYRO UNSAFE");
  } else if (rotationAbortedWheelStart) {
    Serial.println("ABORTED - WHEEL DID NOT START");
  } else if (rotationAbortedWheelMismatch) {
    Serial.println("ABORTED - ONE WHEEL FAILED TO FINISH");
  } else if (rotationAbortedWrongDirection) {
    Serial.println("ABORTED - WRONG DIRECTION");
  } else if (runTimedOut) {
    Serial.println("ABORTED - TIMEOUT");
  } else if (rotationEncoderReplayMode && encoderTargetReached) {
    Serial.println("COMPLETE - ENCODER TARGET REACHED");
  } else if (rotationCalibrationReady) {
    Serial.println("COMPLETE - TICKS READY");
  } else {
    Serial.println("COMPLETE - ADJUST FROM RESULT");
  }
  Serial.print("First Pulse Left     : ");
  Serial.print(firstLeftTickMs);
  Serial.println(" ms");
  Serial.print("First Pulse Right    : ");
  Serial.print(firstRightTickMs);
  Serial.println(" ms");
  Serial.print("Cruise Speed Left    : ");
  Serial.print(cruiseSpeedLeft, 2);
  Serial.println(" cm/s");
  Serial.print("Cruise Speed Right   : ");
  Serial.print(cruiseSpeedRight, 2);
  Serial.println(" cm/s");
  Serial.print("Yaw at stop command  : ");
  Serial.print(yawAtStopCommand, 3);
  Serial.println(" deg");
  Serial.print("Predicted stop Yaw   : ");
  Serial.print(predictedYawAtStop, 3);
  Serial.println(" deg");
  Serial.print("Final Yaw after stop : ");
  Serial.print(finalYaw, 3);
  Serial.println(" deg");
  Serial.print("Corrected Yaw at stop: ");
  Serial.print(correctedYawAtStop, 3);
  Serial.println(" deg");
  Serial.print("Corrected Final Yaw  : ");
  Serial.print(correctedFinalYaw, 3);
  Serial.println(" deg");
  Serial.print("Final Turn Progress  : ");
  Serial.print(finalRotationProgress, 3);
  Serial.println(" deg");
  Serial.print("Final Angle Error    : ");
  Serial.print(finalAngleError, 3);
  Serial.println(" deg");
  Serial.print("Max Rotation Rate    : ");
  Serial.print(maxAbsRotationRate, 2);
  Serial.println(" deg/s");
  Serial.print("Final Gyro Z         : ");
  Serial.print(finalGyroZ, 3);
  Serial.println(" deg/s (residual bias)");
  Serial.print("Gyro Read Failures   : ");
  Serial.println(gyroReadFailures);
  Serial.print("Gyro Bus Recoveries  : ");
  Serial.println(gyroBusRecoveries);
  Serial.print("Gyro Invalid Samples : ");
  Serial.println(gyroInvalidSamples);
  Serial.print("Gyro Data Status     : ");
  Serial.println(gyroDataReliable ? "VALID" : "INVALID - DO NOT CALIBRATE");
  Serial.print("L/R at stop command  : ");
  Serial.print(leftAtStopCommand);
  Serial.print(" / ");
  Serial.println(rightAtStopCommand);
  Serial.print("Final Encoder L/R    : ");
  Serial.print(finalEncoderL);
  Serial.print(" / ");
  Serial.println(finalEncoderR);
  Serial.print("Wheel travel L/R     : ");
  Serial.print(leftAtStopCommand * CM_PER_TICK, 2);
  Serial.print(" / ");
  Serial.print(rightAtStopCommand * CM_PER_TICK, 2);
  Serial.println(" cm");
  Serial.print("Recommended stop L/R: ");
  Serial.print(recommendedLeftTicks, 2);
  Serial.print(" / ");
  Serial.print(recommendedRightTicks, 2);
  Serial.println(" ticks");
  if (gyroDataReliable && measuredFinalAngle > 1.0f) {
    Serial.print("Estimated 90deg L/R : ");
    Serial.print(leftAtStopCommand * 90.0f / measuredFinalAngle, 2);
    Serial.print(" / ");
    Serial.print(rightAtStopCommand * 90.0f / measuredFinalAngle, 2);
    Serial.println(" ticks");
    Serial.print("Estimated 360deg L/R: ");
    Serial.print(leftAtStopCommand * 360.0f / measuredFinalAngle, 2);
    Serial.print(" / ");
    Serial.print(rightAtStopCommand * 360.0f / measuredFinalAngle, 2);
    Serial.println(" ticks");
  }
  Serial.println("====================================");
}

