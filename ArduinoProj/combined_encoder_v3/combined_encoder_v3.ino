// =====================================================
void ISR_encoderR() {
  encoderR++;
}

void ISR_encoderL() {
  encoderL++;
}

void resetEncoders() {
  noInterrupts();
  encoderL = 0;
  encoderR = 0;
  interrupts();
}

void readEncoders(unsigned long &left, unsigned long &right) {
  noInterrupts();
  left = encoderL;
  right = encoderR;
  interrupts();
}

// =====================================================
// CONVERSION
// =====================================================
unsigned long cmToTicks(float cm) {
  return (unsigned long)lroundf(cm / CM_PER_TICK);
}

unsigned long checkpointTicksForIndex(int checkpointIndex,
                                      float totalDistanceCM) {
  float checkpointCM = (checkpointIndex + 1) * CALIBRATION_SEGMENT_CM;
  checkpointCM = min(checkpointCM, totalDistanceCM);
  return cmToTicks(checkpointCM);
}

int speedToPWM(float speed) {
  speed = constrain(speed, 0.0f, 70.0f);
  return constrain((int)(speed * PWM_PER_CM_S), 0, PWM_MAX);
}

float encoderTargetForSegment(int segment) {
  segment = constrain(segment, 0, MAX_CALIBRATION_SEGMENTS - 1);
  if (activeForwardProfile == LONG_RANGE_PROFILE) {
    return LONG_RANGE_ENCODER_TARGET_R_MINUS_L[segment];
  }
  return ENCODER_TARGET_R_MINUS_L[segment];
}

float desiredRightExtraTicks(float distanceCM) {
  if (distanceCM <= 0.0f) return 0.0f;

  int segment = (int)(distanceCM / CALIBRATION_SEGMENT_CM);
  segment = constrain(segment, 0, activeSegmentCount - 1);

  float segmentStartCM = segment * CALIBRATION_SEGMENT_CM;
  float segmentEndCM = (segment == activeSegmentCount - 1)
                     ? commandedDistanceCM
                     : (segment + 1) * CALIBRATION_SEGMENT_CM;
  float segmentLengthCM = segmentEndCM - segmentStartCM;
  if (segmentLengthCM <= 0.0f) segmentLengthCM = CALIBRATION_SEGMENT_CM;
  float fraction = (distanceCM - segmentStartCM)
                 / segmentLengthCM;
  fraction = constrain(fraction, 0.0f, 1.0f);

  float previousTarget = (segment == 0)
                       ? 0.0f
                       : encoderTargetForSegment(segment - 1);
  float nextTarget = encoderTargetForSegment(segment);
  return previousTarget + (nextTarget - previousTarget) * fraction;
}

// =====================================================
// MPU6050
// =====================================================
void writeMPU(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

uint8_t readMPURegister(uint8_t reg) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  if (Wire.endTransmission(false) != 0) return 0;

  Wire.requestFrom((uint8_t)MPU_ADDR, (uint8_t)1);
  if (Wire.available()) return Wire.read();
  return 0;
}

bool readGyroZRawOnce(int16_t &rawValue) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x47); // GYRO_ZOUT_H
  if (Wire.endTransmission(false) != 0) return false;

  uint8_t received = Wire.requestFrom((uint8_t)MPU_ADDR, (uint8_t)2);
  if (received != 2 || Wire.available() < 2) {
    // ล้าง byte ที่ค้างอยู่ ไม่ให้ transaction ถัดไปเสียตาม
    while (Wire.available()) Wire.read();
    return false;
  }

  uint8_t highByte = Wire.read();
  uint8_t lowByte = Wire.read();
  rawValue = (int16_t)(((uint16_t)highByte << 8) | lowByte);
  return true;
}

bool readGyroZRaw(int16_t &rawValue) {
  for (int attempt = 0; attempt < GYRO_READ_RETRIES; attempt++) {
    if (readGyroZRawOnce(rawValue)) {
      if (attempt > 0) gyroRetrySuccesses++;
      return true;
    }

    // เว้นให้บัสกลับสู่สถานะ idle ก่อนลองใหม่
    delayMicroseconds(200);
  }
  return false;
}

bool checkMPU6050() {
  Wire.beginTransmission(MPU_ADDR);
  if (Wire.endTransmission() != 0) return false;

  uint8_t whoAmI = readMPURegister(0x75);
  return (whoAmI == 0x68 || whoAmI == 0x69);
}

void initMPU6050() {
  Wire.begin();
  // 100 kHz ทนต่อสัญญาณรบกวนจากมอเตอร์มากกว่า 400 kHz
  Wire.setClock(100000);
  delay(100);

  if (!checkMPU6050()) {
    // โหมดหลักเป็น Encoder-only จึงไม่ควรค้างทั้งโปรแกรมเมื่อ Gyro หลุด
    gyroAvailable = false;
    gyroDisabledForRun = true;
    return;
  }

  gyroAvailable = true;

  writeMPU(0x6B, 0x00); // Wake up
  delay(100);
  writeMPU(0x1B, 0x00); // Gyro +-250 deg/s, 131 LSB/(deg/s)
  writeMPU(0x1A, 0x05); // DLPF ~10 Hz ลดแรงสั่นจากมอเตอร์
  delay(100);
}

void recoverMPU6050Bus() {
  Wire.end();
  delay(2);
  Wire.begin();
  Wire.setClock(100000);
  delay(2);

  // ตั้งค่าใหม่ เผื่อแรงดันตกจน MPU6050 reset
  writeMPU(0x6B, 0x00);
  writeMPU(0x1B, 0x00);
  writeMPU(0x1A, 0x05);

  consecutiveGyroFailures = 0;
  gyroBusRecoveries++;
}

void calibrateGyro() {
  // ตอนนี้ต้องวางรถนิ่ง
  delay(GYRO_CALIBRATION_SETTLE_MS);

  const int samples = GYRO_CALIBRATION_SAMPLES;
  long total = 0;
  int validSamples = 0;
  int attempts = 0;

  while (validSamples < samples && attempts < samples * 3) {
    int16_t rawValue;
    if (readGyroZRaw(rawValue)) {
      total += rawValue;
      validSamples++;
    }
    attempts++;
    delay(2);
  }

  if (validSamples > 0) {
    gyroZOffset = ((float)total / validSamples) / 131.0f;
  } else {
    gyroZOffset = 0.0f;
  }

  // รายงานเฉพาะ failure ที่เกิดระหว่างการวิ่งและวัดผล
  gyroReadFailures = 0;
  gyroRetrySuccesses = 0;
  gyroBusRecoveries = 0;
  gyroInvalidSamples = 0;
  gyroResidualRejectedSamples = 0;
  gyroReadFailuresAtStop = 0;
  gyroBusRecoveriesAtStop = 0;
  gyroInvalidSamplesAtStop = 0;
  firstLeftTickMs = 0;
  firstRightTickMs = 0;
  consecutiveGyroFailures = 0;
  gyroDisabledForRun = false;
  gyroResidualBiasValid = false;
  yaw = 0.0f;
  lastGyroZ = 0.0f;
  previousGyroMicros = micros();
}

void resetYaw() {
  yaw = 0.0f;
  lastGyroZ = 0.0f;
  previousGyroMicros = micros();
}

void updateGyro() {
  // ถ้ากู้บัสหลายครั้งแล้วยังไม่กลับมา ให้หยุดเรียก MPU ในรอบนี้
  if (!gyroAvailable || gyroDisabledForRun) return;

  unsigned long now = micros();
  unsigned long elapsed = now - previousGyroMicros;

  // ~50 Hz
  if (elapsed < GYRO_UPDATE_INTERVAL_US) return;

  float dt = elapsed / 1000000.0f;
  previousGyroMicros = now;

  int16_t rawValue;
  if (!readGyroZRaw(rawValue)) {
    gyroReadFailures++;
    consecutiveGyroFailures++;
    if (consecutiveGyroFailures >= 5) {
      recoverMPU6050Bus();
      if (gyroBusRecoveries >= MAX_GYRO_RECOVERIES_PER_RUN) {
        gyroDisabledForRun = true;
      }
    }
    return; // ห้ามนำ raw = 0 ปลอมไปสะสมเป็น Yaw
  }

  consecutiveGyroFailures = 0;

  float gyroZ = ((float)rawValue / 131.0f) - gyroZOffset;
  gyroZ *= GYRO_SIGN;

  float maxValidRate = rotationGyroRateMode
                     ? MAX_VALID_ROTATION_GYRO_RATE
                     : MAX_VALID_GYRO_RATE;
  if (fabs(gyroZ) > maxValidRate) {
    gyroInvalidSamples++;
    return;
  }

  // ลด noise ตอนเกือบนิ่ง
  if (fabs(gyroZ) < 0.15f) gyroZ = 0.0f;

  lastGyroZ = gyroZ;
  yaw += gyroZ * dt;
}

float measureResidualGyroBias() {
  // เรียกใช้หลังรถหยุดสนิทเท่านั้น ค่าเฉลี่ยนี้ใช้แก้ drift ย้อนหลัง
  gyroResidualBiasValid = false;
  if (!gyroAvailable || gyroDisabledForRun) return 0.0f;

  const int samples = RESIDUAL_GYRO_SAMPLES;
  float total = 0.0f;
  int validSamples = 0;
  int attempts = 0;
  unsigned long measurementStartMs = millis();

  while (validSamples < samples
         && attempts < samples * 3
         && millis() - measurementStartMs
            < RESIDUAL_MEASUREMENT_TIMEOUT_MS) {
    int16_t rawValue;
    if (readGyroZRaw(rawValue)) {
      float gyroZ = ((float)rawValue / 131.0f) - gyroZOffset;
      gyroZ *= GYRO_SIGN;

      if (fabs(gyroZ) <= MAX_RESIDUAL_SAMPLE_RATE) {
        total += gyroZ;
        validSamples++;
      } else {
        // แยกจาก invalid ระหว่างวิ่ง เพราะไม่ควรทำลาย Yaw at stop
        gyroResidualRejectedSamples++;
      }
      consecutiveGyroFailures = 0;
    } else {
      gyroReadFailures++;
      consecutiveGyroFailures++;
      if (consecutiveGyroFailures >= 5) {
        recoverMPU6050Bus();
        if (gyroBusRecoveries >= MAX_GYRO_RECOVERIES_PER_RUN) {
          gyroDisabledForRun = true;
          break;
        }
      }
    }
    attempts++;
    delay(2);
  }

  // ต้องได้อย่างน้อย 80% จึงถือว่า bias หลังหยุดเชื่อถือได้
  if (validSamples < (samples * 8) / 10) return 0.0f;
  gyroResidualBiasValid = true;
  return total / validSamples;
}

// =====================================================
// MOTOR
// =====================================================
void motorForwardDirection() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

void motorRotateDirection(int direction) {
  if (direction >= 0) {
    // หมุนขวา: ล้อซ้ายเดินหน้า ล้อขวาถอยหลัง
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
  } else {
    // หมุนซ้าย: ล้อซ้ายถอยหลัง ล้อขวาเดินหน้า
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
  }
}

void Stop() {
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}

// Single-channel encoders: no pulses is only an indication of rest.
// Require both a minimum observation interval and a quiet window, with a deadline.
bool waitForEncoderStop() {
  unsigned long start = millis(), lastChange = start;
  unsigned long oldL, oldR;
  readEncoders(oldL, oldR);
  while (millis() - start < 2000) {
    unsigned long left, right;
    readEncoders(left, right);
    unsigned long now = millis();
    if (left != oldL || right != oldR) { lastChange = now; oldL = left; oldR = right; }
    if (now - start >= 500 && now - lastChange >= 200) return true;
    delay(5);
  }
  return false;
}

// L298: เปิด EN เต็มและตั้งขั้วทั้งสองด้านเท่ากันเพื่อ short-brake มอเตอร์
// ใช้เฉพาะตอนจบการหมุน และยังอ่าน Gyro ระหว่างเบรกเพื่อไม่ให้ Yaw ขาดช่วง
void activeBrakeRotation(unsigned long durationMs) {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  analogWrite(ENA, PWM_MAX);
  analogWrite(ENB, PWM_MAX);

  unsigned long brakeStartMs = millis();
  while (millis() - brakeStartMs < durationMs) {
    updateGyro();
    delay(2);
  }
  Stop();
}

// =====================================================
// LEFT WHEEL ONLY TEST
// ใช้ตรวจว่า ENA และ ENC_L เป็นล้อซ้ายจริงหรือไม่
// รถจะโค้งไปทางขวา เพราะล้อขวาไม่หมุน
// =====================================================
void testLeftWheelOnly(float speed, unsigned long durationMs) {
  resetEncoders();
  resetYaw();
  motorForwardDirection();

  unsigned long startMs = millis();

  analogWrite(ENA, speedToPWM(speed)); // ล้อซ้าย
  analogWrite(ENB, 0);                 // ล้อขวาหยุด

  while (millis() - startMs < durationMs) {
    updateGyro();
    delay(2);
  }

  readEncoders(leftAtStopCommand, rightAtStopCommand);
  yawAtStopCommand = yaw;
  gyroReadFailuresAtStop = gyroReadFailures;
  gyroBusRecoveriesAtStop = gyroBusRecoveries;
  gyroInvalidSamplesAtStop = gyroInvalidSamples;
  Stop();
  runTimeMs = millis() - startMs;

  unsigned long settleStart = millis();
  while (millis() - settleStart < SETTLE_TIME_MS) {
    updateGyro();
    delay(2);
  }

  readEncoders(finalEncoderL, finalEncoderR);
  finalYaw = yaw;
  finalGyroZ = lastGyroZ;
  testFinished = true;
}

// =====================================================
// IN-PLACE ROTATION GYRO LEARNING
// ใช้ Gyro หยุดที่มุมเป้าหมาย แล้วบันทึก encoder สำหรับ replay ภายหลัง
// =====================================================
void rotateGyroLearning(float targetAngleDeg, int direction) {
  direction = direction >= 0 ? 1 : -1;
  int yawDirectionSign = RIGHT_TURN_GYRO_SIGN * direction;
  commandedRotationDeg = fabs(targetAngleDeg);
  commandedRotationDirection = direction;
  commandedSpeed = ROTATE_CRUISE_SPEED_CM_S;

  testFinished = false;
  runTimedOut = false;
  rotationAbortedGyro = false;
  rotationAbortedWrongDirection = false;
  rotationAbortedWheelStart = false;
  rotationAbortedWheelMismatch = false;
  rotationGyroRateMode = true;
  predictedYawAtStop = 0.0f;
  maxAbsRotationRate = 0.0f;
  gyroReadFailures = 0;
  gyroRetrySuccesses = 0;
  gyroBusRecoveries = 0;
  gyroInvalidSamples = 0;
  gyroResidualRejectedSamples = 0;
  gyroReadFailuresAtStop = 0;
  gyroBusRecoveriesAtStop = 0;
  gyroInvalidSamplesAtStop = 0;
  consecutiveGyroFailures = 0;
  gyroDisabledForRun = !gyroAvailable;
  gyroResidualBiasValid = false;
  firstLeftTickMs = 0;
  firstRightTickMs = 0;
  cruiseSpeedLeft = 0.0f;
  cruiseSpeedRight = 0.0f;

  resetEncoders();
  resetYaw();
  motorRotateDirection(direction);

  unsigned long startMs = millis();
  unsigned long lastSpeedUpdateMs = startMs;
  unsigned long previousLeftTicks = 0;
  unsigned long previousRightTicks = 0;
  float filteredSpeedLeft = 0.0f;
  float filteredSpeedRight = 0.0f;
  float integralLeft = 0.0f;
  float integralRight = 0.0f;
  int piTrimLeftPWM = 0;
  int piTrimRightPWM = 0;
  bool speedFilterReady = false;
  float cruiseLeftSum = 0.0f;
  float cruiseRightSum = 0.0f;
  unsigned int cruiseSamples = 0;
  unsigned long maxRotationRunMs =
    5000UL + (unsigned long)(commandedRotationDeg * 50.0f);

  while (true) {
    updateGyro();

    unsigned long leftTicks, rightTicks;
    readEncoders(leftTicks, rightTicks);

    if (firstLeftTickMs == 0 && leftTicks > 0) {
      firstLeftTickMs = millis() - startMs;
    }
    if (firstRightTickMs == 0 && rightTicks > 0) {
      firstRightTickMs = millis() - startMs;
    }

    unsigned long elapsedMs = millis() - startMs;
    if (elapsedMs >= ROTATE_WHEEL_START_TIMEOUT_MS
        && (leftTicks == 0 || rightTicks == 0)) {
      rotationAbortedWheelStart = true;
      break;
    }

    if (fabs(lastGyroZ) > maxAbsRotationRate) {
      maxAbsRotationRate = fabs(lastGyroZ);
    }

    bool gyroControlSafe = gyroAvailable
                        && !gyroDisabledForRun
                        && gyroReadFailures <= 20
                        && gyroBusRecoveries <= 2
                        && gyroInvalidSamples <= 5;
    if (!gyroControlSafe) {
      rotationAbortedGyro = true;
      break;
    }

    float progressDeg = yawDirectionSign * yaw;
    float towardTargetRate = yawDirectionSign * lastGyroZ;
    if (progressDeg < -MAX_WRONG_DIRECTION_DEG) {
      rotationAbortedWrongDirection = true;
      break;
    }

    float predictedProgressDeg = progressDeg;
    if (towardTargetRate > 0.0f) {
      predictedProgressDeg += towardTargetRate * ROTATE_STOP_LOOKAHEAD_SEC;
    }
    predictedYawAtStop = yawDirectionSign * predictedProgressDeg;

    if (predictedProgressDeg >= commandedRotationDeg) break;

    if (millis() - startMs >= maxRotationRunMs) {
      runTimedOut = true;
      break;
    }

    float remainingDeg = commandedRotationDeg - progressDeg;
    float approachRatio = constrain(remainingDeg / ROTATE_SLOW_ANGLE_DEG,
                                    0.0f,
                                    1.0f);
    float approachSpeed = ROTATE_MIN_SPEED_CM_S
                        + (ROTATE_CRUISE_SPEED_CM_S
                           - ROTATE_MIN_SPEED_CM_S) * approachRatio;
    float rampRatio = constrain(elapsedMs / (float)ROTATE_SOFT_START_MS,
                                0.0f,
                                1.0f);
    float rampSpeed = ROTATE_MIN_SPEED_CM_S
                    + (ROTATE_CRUISE_SPEED_CM_S
                       - ROTATE_MIN_SPEED_CM_S) * rampRatio;
    float targetWheelSpeed = min(approachSpeed, rampSpeed);

    float encoderDiff = (long)rightTicks - (long)leftTicks;
    float syncSpeed = constrain(KP_ROTATE_SYNC_SPEED * encoderDiff,
                                -MAX_ROTATE_SYNC_SPEED_CM_S,
                                MAX_ROTATE_SYNC_SPEED_CM_S);
    float referenceLeft = constrain(targetWheelSpeed + syncSpeed,
                                    0.0f,
                                    ROTATE_CRUISE_SPEED_CM_S);
    float referenceRight = constrain(targetWheelSpeed - syncSpeed,
                                     0.0f,
                                     ROTATE_CRUISE_SPEED_CM_S);

    unsigned long nowMs = millis();
    unsigned long speedElapsedMs = nowMs - lastSpeedUpdateMs;
    if (speedElapsedMs >= SPEED_CONTROL_INTERVAL_MS) {
      float dt = speedElapsedMs / 1000.0f;
      float measuredLeft =
        ((leftTicks - previousLeftTicks) * CM_PER_TICK) / dt;
      float measuredRight =
        ((rightTicks - previousRightTicks) * CM_PER_TICK) / dt;

      if (!speedFilterReady) {
        filteredSpeedLeft = measuredLeft;
        filteredSpeedRight = measuredRight;
        speedFilterReady = true;
      } else {
        filteredSpeedLeft = 0.6f * measuredLeft
                          + 0.4f * filteredSpeedLeft;
        filteredSpeedRight = 0.6f * measuredRight
                           + 0.4f * filteredSpeedRight;
      }

      float errorLeft = referenceLeft - filteredSpeedLeft;
      float errorRight = referenceRight - filteredSpeedRight;
      integralLeft = constrain(integralLeft + errorLeft * dt,
                               -MAX_SPEED_INTEGRAL,
                               MAX_SPEED_INTEGRAL);
      integralRight = constrain(integralRight + errorRight * dt,
                                -MAX_SPEED_INTEGRAL,
                                MAX_SPEED_INTEGRAL);
      piTrimLeftPWM = (int)(KP_SPEED * errorLeft)
                    + (int)(KI_SPEED * integralLeft);
      piTrimRightPWM = (int)(KP_SPEED * errorRight)
                     + (int)(KI_SPEED * integralRight);
      piTrimLeftPWM = constrain(piTrimLeftPWM, -PWM_MAX, PWM_MAX);
      piTrimRightPWM = constrain(piTrimRightPWM, -PWM_MAX, PWM_MAX);

      if (approachRatio >= 1.0f && rampRatio >= 1.0f) {
        cruiseLeftSum += measuredLeft;
        cruiseRightSum += measuredRight;
        cruiseSamples++;
      }

      previousLeftTicks = leftTicks;
      previousRightTicks = rightTicks;
      lastSpeedUpdateMs = nowMs;
    }

    int pwmLeft = constrain(speedToPWM(referenceLeft) + piTrimLeftPWM,
                            0,
                            PWM_MAX);
    int pwmRight = constrain(speedToPWM(referenceRight) + piTrimRightPWM,
                             0,
                             PWM_MAX);
    pwmLeft = max(pwmLeft, ROTATE_RUNNING_PWM_FLOOR);
    pwmRight = max(pwmRight, ROTATE_RUNNING_PWM_FLOOR);
    if (leftTicks == 0 && elapsedMs < ROTATE_START_KICK_MS) {
      pwmLeft = max(pwmLeft, ROTATE_START_KICK_PWM);
    }
    if (rightTicks == 0 && elapsedMs < ROTATE_START_KICK_MS) {
      pwmRight = max(pwmRight, ROTATE_START_KICK_PWM);
    }
    analogWrite(ENA, pwmLeft);
    analogWrite(ENB, pwmRight);
  }

  runTimeMs = millis() - startMs;
  readEncoders(leftAtStopCommand, rightAtStopCommand);
  yawAtStopCommand = yaw;
  gyroIntegrationTimeMs = runTimeMs;
  gyroReadFailuresAtStop = gyroReadFailures;
  gyroBusRecoveriesAtStop = gyroBusRecoveries;
  gyroInvalidSamplesAtStop = gyroInvalidSamples;
  if (cruiseSamples > 0) {
    cruiseSpeedLeft = cruiseLeftSum / cruiseSamples;
    cruiseSpeedRight = cruiseRightSum / cruiseSamples;
  }

  Stop();
  Serial.println("ROTATION STOPPED - DO NOT TOUCH ROBOT");

  unsigned long settleStart = millis();
  while (millis() - settleStart < SETTLE_TIME_MS) {
    updateGyro();
    delay(2);
  }

  readEncoders(finalEncoderL, finalEncoderR);
  finalYaw = yaw;
  rotationGyroRateMode = false;
  finalGyroZ = measureResidualGyroBias();
  Serial.println("ROTATION MEASUREMENT COMPLETE");
  testFinished = true;
}

// =====================================================
// DIRECT 360-DEG GYRO MEASUREMENT
// Gyro เป็นตัวตัดมุม; encoder ใช้รักษาจำนวนซ้าย/ขวาใกล้กันและบันทึกผล
// =====================================================
void rotateGyroMeasureEncoder(float targetAngleDeg, int direction) {
  direction = direction >= 0 ? 1 : -1;
  int yawDirectionSign = RIGHT_TURN_GYRO_SIGN * direction;
  commandedRotationDeg = fabs(targetAngleDeg);
  commandedRotationDirection = direction;
  commandedSpeed = 0.0f;
  rotationEncoderReplayMode = false;

  testFinished = false;
  runTimedOut = false;
  rotationAbortedGyro = false;
  rotationAbortedWrongDirection = false;
  rotationAbortedWheelStart = false;
  rotationAbortedWheelMismatch = false;
  rotationGyroRateMode = true;
  predictedYawAtStop = 0.0f;
  maxAbsRotationRate = 0.0f;
  gyroReadFailures = 0;
  gyroRetrySuccesses = 0;
  gyroBusRecoveries = 0;
  gyroInvalidSamples = 0;
  gyroResidualRejectedSamples = 0;
  gyroReadFailuresAtStop = 0;
  gyroBusRecoveriesAtStop = 0;
  gyroInvalidSamplesAtStop = 0;
  consecutiveGyroFailures = 0;
  gyroDisabledForRun = !gyroAvailable;
  gyroResidualBiasValid = false;
  firstLeftTickMs = 0;
  firstRightTickMs = 0;
  cruiseSpeedLeft = 0.0f;
  cruiseSpeedRight = 0.0f;

  resetEncoders();
  resetYaw();
  motorRotateDirection(direction);

  unsigned long startMs = millis();
  unsigned long maxRotationRunMs =
    8000UL + (unsigned long)(commandedRotationDeg * 50.0f);

  while (true) {
    updateGyro();

    unsigned long leftTicks, rightTicks;
    readEncoders(leftTicks, rightTicks);
    unsigned long elapsedMs = millis() - startMs;

    if (firstLeftTickMs == 0 && leftTicks > 0) {
      firstLeftTickMs = elapsedMs;
    }
    if (firstRightTickMs == 0 && rightTicks > 0) {
      firstRightTickMs = elapsedMs;
    }
    if (fabs(lastGyroZ) > maxAbsRotationRate) {
      maxAbsRotationRate = fabs(lastGyroZ);
    }

    bool gyroControlSafe = gyroAvailable
                        && !gyroDisabledForRun
                        && gyroReadFailures <= 20
                        && gyroBusRecoveries <= 2
                        && gyroInvalidSamples <= 5;
    if (!gyroControlSafe) {
      rotationAbortedGyro = true;
      break;
    }

    if (elapsedMs >= ROTATE_WHEEL_START_TIMEOUT_MS
        && (leftTicks == 0 || rightTicks == 0)) {
      rotationAbortedWheelStart = true;
      break;
    }

    float progressDeg = yawDirectionSign * yaw;
    if (progressDeg < -MAX_WRONG_DIRECTION_DEG) {
      rotationAbortedWrongDirection = true;
      break;
    }
    predictedYawAtStop = yaw;

    // รอบนี้ตั้งใจรอให้ Gyro วัดถึงมุมจริงก่อนจึงตัดกำลัง
    if (progressDeg >= commandedRotationDeg) break;
    if (elapsedMs >= maxRotationRunMs) {
      runTimedOut = true;
      break;
    }

    float remainingDeg = commandedRotationDeg - progressDeg;
    int basePWM = elapsedMs < ROTATE_DIRECT_START_MS
                ? ROTATE_DIRECT_START_PWM
                : ROTATE_DIRECT_CRUISE_PWM;
    if (remainingDeg < ROTATE_DIRECT_SLOW_ANGLE_DEG) {
      float slowRatio = constrain(
        remainingDeg / ROTATE_DIRECT_SLOW_ANGLE_DEG,
        0.0f,
        1.0f
      );
      basePWM = ROTATE_DIRECT_SLOW_PWM
              + (int)((ROTATE_DIRECT_CRUISE_PWM
                       - ROTATE_DIRECT_SLOW_PWM) * slowRatio);
    }

    long countError = (long)rightTicks - (long)leftTicks;
    int countCorrection = constrain(
      (int)(KP_ROTATE_COUNT_PWM * countError),
      -MAX_ROTATE_COUNT_PWM_CORRECTION,
      MAX_ROTATE_COUNT_PWM_CORRECTION
    );
    // เพิ่มเฉพาะล้อที่ตามหลัง ห้ามลดอีกล้อต่ำกว่า basePWM เพราะจากผลจริง
    // PWM ต่ำกว่า 2000 ทำให้มอเตอร์มีเสียงแต่แรงไม่พอหมุน
    int pwmLeft = basePWM;
    int pwmRight = basePWM;
    if (countCorrection > 0) {
      pwmLeft = constrain(basePWM + countCorrection, 0, PWM_MAX);
    } else if (countCorrection < 0) {
      pwmRight = constrain(basePWM - countCorrection, 0, PWM_MAX);
    }
    analogWrite(ENA, pwmLeft);
    analogWrite(ENB, pwmRight);
  }

  runTimeMs = millis() - startMs;
  readEncoders(leftAtStopCommand, rightAtStopCommand);
  yawAtStopCommand = yaw;
  gyroIntegrationTimeMs = runTimeMs;
  gyroReadFailuresAtStop = gyroReadFailures;
  gyroBusRecoveriesAtStop = gyroBusRecoveries;
  gyroInvalidSamplesAtStop = gyroInvalidSamples;
  if (runTimeMs > 0) {
    float runTimeSec = runTimeMs / 1000.0f;
    cruiseSpeedLeft = leftAtStopCommand * CM_PER_TICK / runTimeSec;
    cruiseSpeedRight = rightAtStopCommand * CM_PER_TICK / runTimeSec;
  }

  Stop();
  Serial.println("360 ROTATION STOPPED - DO NOT TOUCH ROBOT");

  unsigned long settleStart = millis();
  while (millis() - settleStart < SETTLE_TIME_MS) {
    updateGyro();
    delay(2);
  }

  readEncoders(finalEncoderL, finalEncoderR);
  finalYaw = yaw;
  rotationGyroRateMode = false;
  finalGyroZ = measureResidualGyroBias();
  Serial.println("360 ROTATION MEASUREMENT COMPLETE");
  testFinished = true;
}

// =====================================================
// ENCODER-ONLY ROTATION REPLAY
// Encoder เป็นตัวสั่งหยุด; Gyro ใช้บันทึกผลเท่านั้นและถอดออกได้ตอนสอบ
// =====================================================
void rotateEncoderReplay(float targetAngleDeg, int direction) {
  direction = direction >= 0 ? 1 : -1;
  commandedRotationDeg = fabs(targetAngleDeg);
  commandedRotationDirection = direction;
  commandedSpeed = ROTATE_REPLAY_SPEED_CM_S;
  rotationEncoderReplayMode = true;

  float learnedLeftTicks360 = direction > 0
                            ? ROTATE_RIGHT_LEFT_TICKS_360
                            : ROTATE_LEFT_LEFT_TICKS_360;
  float learnedRightTicks360 = direction > 0
                             ? ROTATE_RIGHT_RIGHT_TICKS_360
                             : ROTATE_LEFT_RIGHT_TICKS_360;
  float angleScale = commandedRotationDeg / 360.0f;
  rotationTargetLeftTicks = max(
    1UL,
    (unsigned long)lroundf(learnedLeftTicks360 * angleScale)
  );
  rotationTargetRightTicks = max(
    1UL,
    (unsigned long)lroundf(learnedRightTicks360 * angleScale)
  );

  testFinished = false;
  runTimedOut = false;
  rotationAbortedGyro = false;
  rotationAbortedWrongDirection = false;
  rotationAbortedWheelStart = false;
  rotationAbortedWheelMismatch = false;
  rotationGyroRateMode = true;
  predictedYawAtStop = 0.0f;
  maxAbsRotationRate = 0.0f;
  gyroReadFailures = 0;
  gyroRetrySuccesses = 0;
  gyroBusRecoveries = 0;
  gyroInvalidSamples = 0;
  gyroResidualRejectedSamples = 0;
  gyroReadFailuresAtStop = 0;
  gyroBusRecoveriesAtStop = 0;
  gyroInvalidSamplesAtStop = 0;
  consecutiveGyroFailures = 0;
  gyroDisabledForRun = !gyroAvailable;
  gyroResidualBiasValid = false;
  firstLeftTickMs = 0;
  firstRightTickMs = 0;
  cruiseSpeedLeft = 0.0f;
  cruiseSpeedRight = 0.0f;

  resetEncoders();
  resetYaw();
  motorRotateDirection(direction);

  unsigned long startMs = millis(), previousControlMs = startMs;
  unsigned long previousL = 0, previousR = 0;
  unsigned long oneDoneSince = 0;
  unsigned long lastL = startMs, lastR = startMs;
  EncoderMotion::Profile profile;
  EncoderMotion::Wheel wheelL(startMs), wheelR(startMs);
  unsigned long maxRotationRunMs = 5000UL + (unsigned long)(commandedRotationDeg * 80.0f);
  while (true) {
    updateGyro();
    unsigned long leftTicks, rightTicks;
    readEncoders(leftTicks, rightTicks);
    unsigned long now = millis();
    if (leftTicks != previousL) { lastL = now; previousL = leftTicks; }
    if (rightTicks != previousR) { lastR = now; previousR = rightTicks; }
    if (!firstLeftTickMs && leftTicks) firstLeftTickMs = now - startMs;
    if (!firstRightTickMs && rightTicks) firstRightTickMs = now - startMs;
    bool doneL = leftTicks >= rotationTargetLeftTicks;
    bool doneR = rightTicks >= rotationTargetRightTicks;
    if (doneL && doneR) break;
    if (doneL != doneR) {
      if (!oneDoneSince) oneDoneSince = now;
      if (now - oneDoneSince >= ROTATE_ONE_WHEEL_TIMEOUT_MS) {
        rotationAbortedWheelMismatch = true;
        break;
      }
    } else oneDoneSince = 0;
    if ((!doneL && now - lastL >= 2000) || (!doneR && now - lastR >= 2000)) {
      rotationAbortedWheelStart = true;
      break;
    }
    if (now - startMs >= maxRotationRunMs) { runTimedOut = true; break; }
    float dt = (now - previousControlMs) * 0.001f;
    previousControlMs = now;
    EncoderMotion::References refs = profile.step(
      leftTicks, rightTicks, rotationTargetLeftTicks, rotationTargetRightTicks,
      CM_PER_TICK, ROTATE_REPLAY_SPEED_CM_S, 10.0f, 30.0f, 40.0f, dt);
    int pwmL = wheelL.update(now, leftTicks, refs.left, CM_PER_TICK, PWM_MAX,
                             2400.0f / 4095.0f, 600.0f / 4095.0f);
    int pwmR = wheelR.update(now, rightTicks, refs.right, CM_PER_TICK, PWM_MAX,
                             2400.0f / 4095.0f, 600.0f / 4095.0f);
    // Bounded startup assist; never repeatedly kick a stalled wheel.
    if (now - startMs < 200) {
      if (!leftTicks && refs.left > 0) pwmL = ROTATE_DIRECT_START_PWM;
      if (!rightTicks && refs.right > 0) pwmR = ROTATE_DIRECT_START_PWM;
    }
    analogWrite(ENA, doneL ? 0 : pwmL);
    analogWrite(ENB, doneR ? 0 : pwmR);
    delay(5);
  }

  runTimeMs = millis() - startMs;
  readEncoders(leftAtStopCommand, rightAtStopCommand);
  yawAtStopCommand = yaw;
  predictedYawAtStop = yaw;
  gyroIntegrationTimeMs = runTimeMs;
  gyroReadFailuresAtStop = gyroReadFailures;
  gyroBusRecoveriesAtStop = gyroBusRecoveries;
  gyroInvalidSamplesAtStop = gyroInvalidSamples;
  if (runTimeMs > 0) {
    float runTimeSec = runTimeMs / 1000.0f;
    cruiseSpeedLeft = leftAtStopCommand * CM_PER_TICK / runTimeSec;
    cruiseSpeedRight = rightAtStopCommand * CM_PER_TICK / runTimeSec;
  }

  activeBrakeRotation(ROTATE_ACTIVE_BRAKE_MS);
  motionSettled = waitForEncoderStop();
  Serial.println("ENCODER ROTATION STOPPED - DO NOT TOUCH ROBOT");

  unsigned long settleStart = millis();
  while (millis() - settleStart < SETTLE_TIME_MS) {
    updateGyro();
    delay(2);
  }

  readEncoders(finalEncoderL, finalEncoderR);
  finalYaw = yaw;
  rotationGyroRateMode = false;
  finalGyroZ = measureResidualGyroBias();
  Serial.print("STOP_COUNTS L/R: "); Serial.print(leftAtStopCommand);
  Serial.print('/'); Serial.println(rightAtStopCommand);
  Serial.print("FINAL_COUNTS L/R: "); Serial.print(finalEncoderL);
  Serial.print('/'); Serial.println(finalEncoderR);
  Serial.print("ENCODER_SETTLED: "); Serial.println(motionSettled ? "YES" : "NO");
  Serial.println("ENCODER ROTATION REPLAY FINISHED");
  testFinished = true;
}

// =====================================================
// STAGED GYRO-LEARNING / ENCODER-ONLY REPLAY RUN
// speedCMPerSec คือความเร็วเป้าหมายจริง ไม่ใช่เปอร์เซ็นต์ PWM
// โหมดกำหนดด้วย USE_GYRO_ASSIST
// =====================================================
void forwardClosedLoop(float speedCMPerSec, float distanceCM) {
  activeSegmentCount = (int)ceilf(distanceCM / CALIBRATION_SEGMENT_CM);
  activeSegmentCount = constrain(activeSegmentCount,
                                 1,
                                 MAX_CALIBRATION_SEGMENTS);
  commandedDistanceCM = distanceCM;
  testFinished = false;

  resetEncoders();
  resetYaw();
  motorForwardDirection();

  const unsigned long targetTicks = cmToTicks(distanceCM);
  const unsigned long slowZoneTicks = cmToTicks(SLOW_ZONE_CM);
  const unsigned long warmupTicks = cmToTicks(15.0f);

  commandedSpeed = speedCMPerSec;
  runTimedOut = false;
  straightStalled = false;
  gyroReadFailures = 0;
  gyroRetrySuccesses = 0;
  gyroBusRecoveries = 0;
  gyroInvalidSamples = 0;
  gyroResidualRejectedSamples = 0;
  gyroReadFailuresAtStop = 0;
  gyroBusRecoveriesAtStop = 0;
  gyroInvalidSamplesAtStop = 0;
  consecutiveGyroFailures = 0;
  gyroDisabledForRun = !gyroAvailable;
  gyroResidualBiasValid = false;
  learningAbortedGyro = false;
  learningAbortedYawLimit = false;
  capturedSegmentCount = 0;
  firstLeftTickMs = 0;
  firstRightTickMs = 0;
  cruiseSpeedLeft = 0.0f;
  cruiseSpeedRight = 0.0f;

  for (int i = 0; i < MAX_CALIBRATION_SEGMENTS; i++) {
    segmentYaw[i] = 0.0f;
    segmentGyroRateAtCheckpoint[i] = 0.0f;
    segmentMaxAbsYaw[i] = 0.0f;
    segmentTimeSec[i] = 0.0f;
    segmentEncoderL[i] = 0;
    segmentEncoderR[i] = 0;
    checkpointEncoderL[i] = 0;
    checkpointEncoderR[i] = 0;
    segmentGyroCorrectionSum[i] = 0.0f;
    segmentGyroSpeedCorrectionSum[i] = 0.0f;
    segmentLearningBalancePWMSum[i] = 0.0f;
    segmentGyroCorrectionSamples[i] = 0;
  }

  int nextSegmentToCapture = 0;
  unsigned long accumulatedPauseMs = 0;
  float stageStartAverageTicks = 0.0f;
  float nextCheckpointAverageTicks =
    checkpointTicksForIndex(0, distanceCM);
  unsigned long stageStartLeftTicks = 0;
  unsigned long stageStartRightTicks = 0;

  unsigned long startMs = millis();
  unsigned long stageMotionStartMs = startMs;
  unsigned long lastMovingL = startMs, lastMovingR = startMs;
  unsigned long observedL = 0, observedR = 0;
  unsigned long lastSpeedUpdateMs = startMs;
  unsigned long previousSpeedLeftTicks = 0;
  unsigned long previousSpeedRightTicks = 0;

  float filteredSpeedLeft = 0.0f;
  float filteredSpeedRight = 0.0f;
  float speedIntegralLeft = 0.0f;
  float speedIntegralRight = 0.0f;
  float commonSpeedIntegral = 0.0f;
  bool speedFilterReady = false;
  // Feed-forward คำนวณทุก loop; PI trim อัปเดตจาก encoder ทุก 200 ms
  int piTrimLeftPWM = 0;
  int piTrimRightPWM = 0;
  float cruiseSpeedLeftSum = 0.0f;
  float cruiseSpeedRightSum = 0.0f;
  unsigned int cruiseSamples = 0;

  while (true) {
    updateGyro();

    unsigned long leftTicks, rightTicks;
    readEncoders(leftTicks, rightTicks);

    if (firstLeftTickMs == 0 && leftTicks > 0) {
      firstLeftTickMs = millis() - startMs;
    }
    if (firstRightTickMs == 0 && rightTicks > 0) {
      firstRightTickMs = millis() - startMs;
    }

    // ใช้ระยะเฉลี่ยของสองล้อเป็นระยะของตัวรถ
    float averageTicks = (leftTicks + rightTicks) * 0.5f;
    unsigned long movementNow = millis();
    if (leftTicks != observedL) { observedL = leftTicks; lastMovingL = movementNow; }
    if (rightTicks != observedR) { observedR = rightTicks; lastMovingR = movementNow; }
    if ((leftTicks < targetTicks && movementNow - lastMovingL >= 2000)
        || (rightTicks < targetTicks && movementNow - lastMovingR >= 2000)) {
      straightStalled = true;
      leftAtStopCommand = leftTicks; rightAtStopCommand = rightTicks;
      Serial.println("STRAIGHT STALL - NO ENCODER PROGRESS");
      break;
    }


    bool gyroControlSafe = gyroAvailable
                        && !gyroDisabledForRun
                        && gyroReadFailures <= 20
                        && gyroBusRecoveries <= 2
                        && gyroInvalidSamples <= 5;

    // รอบเรียนรู้ต้องใช้ Gyro ตลอดทาง ถ้าข้อมูลเสียให้หยุดทันที
    // ห้ามกลับไปบังคับ R-L = 0 เพราะจะลบค่าที่เพิ่งเรียนและทำให้รถหัก
    if (USE_GYRO_ASSIST && !gyroControlSafe) {
      learningAbortedGyro = true;
      yawAtStopCommand = yaw;
      leftAtStopCommand = leftTicks;
      rightAtStopCommand = rightTicks;
      gyroIntegrationTimeMs = millis() - startMs;
      gyroReadFailuresAtStop = gyroReadFailures;
      gyroBusRecoveriesAtStop = gyroBusRecoveries;
      gyroInvalidSamplesAtStop = gyroInvalidSamples;
      break;
    }

    // ป้องกันรถเลี้ยวแรงหากทิศ Gyro หรือการต่อมอเตอร์ผิดจากที่ตรวจไว้
    if (USE_GYRO_ASSIST && fabs(yaw) >= MAX_LEARNING_YAW_DEG) {
      learningAbortedYawLimit = true;
      yawAtStopCommand = yaw;
      leftAtStopCommand = leftTicks;
      rightAtStopCommand = rightTicks;
      gyroIntegrationTimeMs = millis() - startMs;
      gyroReadFailuresAtStop = gyroReadFailures;
      gyroBusRecoveriesAtStop = gyroBusRecoveries;
      gyroInvalidSamplesAtStop = gyroInvalidSamples;
      break;
    }

    float gyroSpeedCorrection = 0.0f;
    if (USE_GYRO_ASSIST) {
      float yawForP = fabs(yaw) > GYRO_HEADING_DEADBAND_DEG
                    ? yaw
                    : 0.0f;
      gyroSpeedCorrection = constrain(
        KP_GYRO_HEADING_SPEED * yawForP
          + KD_GYRO_RATE_SPEED * lastGyroZ,
        -MAX_GYRO_SPEED_CORRECTION,
        MAX_GYRO_SPEED_CORRECTION
      );
    }

    int trackingSegment = min(nextSegmentToCapture,
                              activeSegmentCount - 1);
    if (fabs(yaw) > segmentMaxAbsYaw[trackingSegment]) {
      segmentMaxAbsYaw[trackingSegment] = fabs(yaw);
    }

    if (millis() - startMs >= MAX_RUN_TIME_MS) {
      runTimedOut = true;
      yawAtStopCommand = yaw;
      leftAtStopCommand = leftTicks;
      rightAtStopCommand = rightTicks;
      gyroIntegrationTimeMs = millis() - startMs;
      gyroReadFailuresAtStop = gyroReadFailures;
      gyroBusRecoveriesAtStop = gyroBusRecoveries;
      gyroInvalidSamplesAtStop = gyroInvalidSamples;
      break;
    }

    // จับค่าตอนข้ามเส้น 100, 200, ... cm เพียงครั้งเดียวต่อเส้น
    // เก็บทั้งมุม เวลา และ encoder เพื่อให้เทียบแต่ละช่วงย้อนหลังได้
    while (nextSegmentToCapture < activeSegmentCount) {
      bool finalCheckpoint =
        nextSegmentToCapture == activeSegmentCount - 1;
      if (finalCheckpoint) {
        if (activeForwardProfile == LONG_RANGE_PROFILE) {
          // longrangegood ให้ล้อทั้งสองข้างถึงระยะเป้าหมายก่อนจบสเตจ
          if (leftTicks < targetTicks || rightTicks < targetTicks) break;
        } else {
          // shortpathgood รักษาค่า R-L ที่เรียนไว้และหยุดที่ระยะกึ่งกลาง
          if (averageTicks < targetTicks) break;
        }
      } else if (averageTicks < nextCheckpointAverageTicks) {
        break;
      }

      segmentYaw[nextSegmentToCapture] = yaw;
      segmentGyroRateAtCheckpoint[nextSegmentToCapture] = lastGyroZ;
      segmentTimeSec[nextSegmentToCapture] =
        (millis() - startMs) / 1000.0f;
      // เก็บ tick เฉพาะ 100 cm ช่วงนี้ ไม่รวมช่วงก่อนหน้าและช่วงหยุด
      segmentEncoderL[nextSegmentToCapture] =
        leftTicks - stageStartLeftTicks;
      segmentEncoderR[nextSegmentToCapture] =
        rightTicks - stageStartRightTicks;
      checkpointEncoderL[nextSegmentToCapture] = leftTicks;
      checkpointEncoderR[nextSegmentToCapture] = rightTicks;
      nextSegmentToCapture++;
      capturedSegmentCount = nextSegmentToCapture;

      // สามารถเลือกหยุด 3 วินาทีระหว่างช่วง หรือวิ่งต่อเนื่องได้
      if (PAUSE_AT_CHECKPOINTS
          && nextSegmentToCapture < activeSegmentCount) {
        Stop();

        Serial.print("Checkpoint ");
        Serial.print(nextSegmentToCapture * CALIBRATION_SEGMENT_CM, 0);
        Serial.print(" cm | Yaw: ");
        Serial.print(yaw, 3);
        Serial.print(" deg | R-L: ");
        Serial.println((long)checkpointEncoderR[nextSegmentToCapture - 1]
                     - (long)checkpointEncoderL[nextSegmentToCapture - 1]);

        unsigned long pauseStart = millis();
        while (millis() - pauseStart < SEGMENT_PAUSE_MS) {
          updateGyro();
          delay(2);
        }
        accumulatedPauseMs += millis() - pauseStart;

        // เริ่มตัวควบคุมความเร็วใหม่ ไม่ให้ช่วงหยุดถูกคิดเป็นความเร็วศูนย์
        readEncoders(previousSpeedLeftTicks, previousSpeedRightTicks);
        stageStartAverageTicks = (previousSpeedLeftTicks
                                + previousSpeedRightTicks) * 0.5f;
        stageStartLeftTicks = previousSpeedLeftTicks;
        stageStartRightTicks = previousSpeedRightTicks;
        nextCheckpointAverageTicks = checkpointTicksForIndex(
          nextSegmentToCapture,
          distanceCM
        );
        lastSpeedUpdateMs = millis();
        stageMotionStartMs = lastSpeedUpdateMs;
        lastMovingL = lastMovingR = lastSpeedUpdateMs;
        filteredSpeedLeft = 0.0f;
        filteredSpeedRight = 0.0f;
        speedIntegralLeft = 0.0f;
        speedIntegralRight = 0.0f;
        commonSpeedIntegral = 0.0f;
        speedFilterReady = false;
        piTrimLeftPWM = 0;
        piTrimRightPWM = 0;
        motorForwardDirection();
      } else if (nextSegmentToCapture < activeSegmentCount) {
        // โหมดวิ่งต่อเนื่อง: เริ่มนับ 100 cm ช่วงใหม่ทันทีโดยไม่หยุด
        stageStartAverageTicks = averageTicks;
        stageStartLeftTicks = leftTicks;
        stageStartRightTicks = rightTicks;
        nextCheckpointAverageTicks = checkpointTicksForIndex(
          nextSegmentToCapture,
          distanceCM
        );
      }
    }

    if (nextSegmentToCapture >= activeSegmentCount) {
      yawAtStopCommand = yaw;
      leftAtStopCommand = leftTicks;
      rightAtStopCommand = rightTicks;
      gyroIntegrationTimeMs = millis() - startMs;
      gyroReadFailuresAtStop = gyroReadFailures;
      gyroBusRecoveriesAtStop = gyroBusRecoveries;
      gyroInvalidSamplesAtStop = gyroInvalidSamples;
      break;
    }

    // สร้างความเร็วเป้าหมายแบบลดลงเมื่อใกล้ถึงระยะสุดท้าย
    float remainingTicks = nextCheckpointAverageTicks - averageTicks;
    float targetSpeedNow = speedCMPerSec;

    // ค่อย ๆ เพิ่มความเร็วหลังออกตัวแต่ละช่วง ลดกระแสกระชากและไฟตก
    unsigned long stageMotionElapsedMs = millis() - stageMotionStartMs;
    if (stageMotionElapsedMs < MOTOR_SOFT_START_MS) {
      float ramp = stageMotionElapsedMs / (float)MOTOR_SOFT_START_MS;
      float rampSpeed = MIN_SLOW_SPEED_CM_S
                      + (speedCMPerSec - MIN_SLOW_SPEED_CM_S) * ramp;
      targetSpeedNow = min(targetSpeedNow, rampSpeed);
    }

    bool approachingRealStop = PAUSE_AT_CHECKPOINTS
                            || nextSegmentToCapture
                               == activeSegmentCount - 1;
    if (approachingRealStop && remainingTicks < slowZoneTicks) {
      float ratio = remainingTicks / slowZoneTicks;
      float minimumSpeed = min(10.0f, speedCMPerSec);
      float slowSpeed = max(minimumSpeed, sqrtf(2.0f * 40.0f * max(0.0f, remainingTicks * CM_PER_TICK)));
      targetSpeedNow = min(targetSpeedNow, slowSpeed);
    }

    float syncSpeed = 0.0f;
    if (!USE_GYRO_ASSIST) {
      float desiredEncoderDiff = desiredRightExtraTicks(
        averageTicks * CM_PER_TICK
      );
      float encoderPositionError =
        ((long)rightTicks - (long)leftTicks) - desiredEncoderDiff;
      syncSpeed = constrain(KP_SYNC_SPEED * encoderPositionError,
                            -MAX_SYNC_SPEED_CM_S,
                            MAX_SYNC_SPEED_CM_S);
    }

    // คำนวณทุก loop เพื่อให้ Gyro 50 Hz ส่งคำสั่งถึงมอเตอร์ทันที
    float speedReferenceLeft = targetSpeedNow + syncSpeed
                             - gyroSpeedCorrection;
    float speedReferenceRight = targetSpeedNow - syncSpeed
                              + gyroSpeedCorrection;
    speedReferenceLeft = constrain(speedReferenceLeft, 0.0f, 70.0f);
    speedReferenceRight = constrain(speedReferenceRight, 0.0f, 70.0f);

    // -----------------------------
    // Encoder speed PI control
    // วัดทุก 200 ms; dual-edge ให้ประมาณ 40 counts/rev
    // -----------------------------
    unsigned long nowMs = millis();
    unsigned long speedElapsedMs = nowMs - lastSpeedUpdateMs;

    if (speedElapsedMs >= SPEED_CONTROL_INTERVAL_MS) {
      float dt = speedElapsedMs / 1000.0f;
      unsigned long deltaLeft = leftTicks - previousSpeedLeftTicks;
      unsigned long deltaRight = rightTicks - previousSpeedRightTicks;

      float measuredSpeedLeft = (deltaLeft * CM_PER_TICK) / dt;
      float measuredSpeedRight = (deltaRight * CM_PER_TICK) / dt;

      // เก็บเฉพาะช่วงกลาง ไม่รวมการออกตัวและช่วงชะลอ
      float stageProgressTicks = averageTicks - stageStartAverageTicks;
      if (stageProgressTicks >= warmupTicks && remainingTicks >= slowZoneTicks) {
        cruiseSpeedLeftSum += measuredSpeedLeft;
        cruiseSpeedRightSum += measuredSpeedRight;
        cruiseSamples++;
      }

      if (!speedFilterReady) {
        filteredSpeedLeft = measuredSpeedLeft;
        filteredSpeedRight = measuredSpeedRight;
        speedFilterReady = true;
      } else {
        // Low-pass filter ลดการกระโดดครั้งละหนึ่ง encoder tick
        filteredSpeedLeft = 0.6f * measuredSpeedLeft
                          + 0.4f * filteredSpeedLeft;
        filteredSpeedRight = 0.6f * measuredSpeedRight
                           + 0.4f * filteredSpeedRight;
      }

      float speedErrorLeft = speedReferenceLeft - filteredSpeedLeft;
      float speedErrorRight = speedReferenceRight - filteredSpeedRight;

      if (USE_GYRO_ASSIST) {
        // Integral ร่วมคุมเฉพาะความเร็วเฉลี่ย จึงไม่ทิ้งแรงต่างซ้าย-ขวาค้าง
        float averageSpeedError = targetSpeedNow
          - (filteredSpeedLeft + filteredSpeedRight) * 0.5f;
        commonSpeedIntegral += averageSpeedError * dt;
        commonSpeedIntegral = constrain(commonSpeedIntegral,
                                        -MAX_COMMON_SPEED_INTEGRAL,
                                        MAX_COMMON_SPEED_INTEGRAL);
        int commonIntegralPWM =
          (int)(KI_COMMON_LEARNING_SPEED * commonSpeedIntegral);
        piTrimLeftPWM = (int)(KP_LEARNING_SPEED * speedErrorLeft)
                      + commonIntegralPWM;
        piTrimRightPWM = (int)(KP_LEARNING_SPEED * speedErrorRight)
                       + commonIntegralPWM;
      } else {
        speedIntegralLeft = EncoderMotion::integrate(
          speedIntegralLeft, speedErrorLeft, dt, KI_SPEED,
          speedToPWM(speedReferenceLeft) + KP_SPEED * speedErrorLeft,
          0, PWM_MAX, MAX_SPEED_INTEGRAL);
        speedIntegralRight = EncoderMotion::integrate(
          speedIntegralRight, speedErrorRight, dt, KI_SPEED,
          speedToPWM(speedReferenceRight) + KP_SPEED * speedErrorRight,
          0, PWM_MAX, MAX_SPEED_INTEGRAL);
        speedIntegralLeft = constrain(speedIntegralLeft,
                                      -MAX_SPEED_INTEGRAL,
                                      MAX_SPEED_INTEGRAL);
        speedIntegralRight = constrain(speedIntegralRight,
                                       -MAX_SPEED_INTEGRAL,
                                       MAX_SPEED_INTEGRAL);
        piTrimLeftPWM = (int)(KP_SPEED * speedErrorLeft)
                      + (int)(KI_SPEED * speedIntegralLeft);
        piTrimRightPWM = (int)(KP_SPEED * speedErrorRight)
                       + (int)(KI_SPEED * speedIntegralRight);
      }
      piTrimLeftPWM = constrain(piTrimLeftPWM, -PWM_MAX, PWM_MAX);
      piTrimRightPWM = constrain(piTrimRightPWM, -PWM_MAX, PWM_MAX);

      previousSpeedLeftTicks = leftTicks;
      previousSpeedRightTicks = rightTicks;
      lastSpeedUpdateMs = nowMs;
    }

    int activeSegment = min(nextSegmentToCapture,
                            activeSegmentCount - 1);
    float replayPWMTrim = USE_GYRO_ASSIST
                        ? 0.0f
                        : ENCODER_ONLY_PWM_TRIM[activeSegment];
    int feedForwardPWMLeft = speedToPWM(speedReferenceLeft);
    int feedForwardPWMRight = speedToPWM(speedReferenceRight);
    int learningBalancePWM = 0;
    if (USE_GYRO_ASSIST && commandedSpeed > 0.0f) {
      float balanceScale = constrain(targetSpeedNow / commandedSpeed,
                                     0.0f,
                                     1.0f);
      learningBalancePWM =
        (int)(LEARNING_BALANCE_PWM_AT_35_CM_S * balanceScale);
    }
    int pwmLeft = constrain(feedForwardPWMLeft + piTrimLeftPWM
                          - learningBalancePWM
                          - (int)replayPWMTrim,
                            0,
                            PWM_MAX);
    int pwmRight = constrain(feedForwardPWMRight + piTrimRightPWM
                           + learningBalancePWM
                           + (int)replayPWMTrim,
                             0,
                             PWM_MAX);

    // longrangegood หยุดล้อที่ถึงเป้าหมายแล้ว ให้อีกข้างวิ่งตามให้ครบระยะ
    if (activeForwardProfile == LONG_RANGE_PROFILE
        && nextSegmentToCapture == activeSegmentCount - 1) {
      if (leftTicks >= targetTicks) pwmLeft = 0;
      if (rightTicks >= targetTicks) pwmRight = 0;
    }

    // Boost เฉพาะก่อนล้อขวาให้ pulse แรก แล้วหยุดทันทีเมื่อเริ่มหมุน
    unsigned long sinceStartMs = millis() - startMs;
    if (rightTicks == 0 && sinceStartMs < RIGHT_START_BOOST_MS) {
      float boostRatio = 1.0f
                       - sinceStartMs / (float)RIGHT_START_BOOST_MS;
      int rightBoost = (int)(RIGHT_START_BOOST_PWM * boostRatio);
      pwmRight = constrain(pwmRight + rightBoost, 0, PWM_MAX);
    }

    // ค่าเฉลี่ย differential PWM ต่อหนึ่งล้อ: บวก = ขวาแรงกว่าซ้าย
    float appliedDifferentialPWM = (pwmRight - pwmLeft) * 0.5f;
    segmentGyroCorrectionSum[activeSegment] += appliedDifferentialPWM;
    segmentGyroSpeedCorrectionSum[activeSegment] += gyroSpeedCorrection;
    segmentLearningBalancePWMSum[activeSegment] += learningBalancePWM;
    segmentGyroCorrectionSamples[activeSegment]++;

    analogWrite(ENA, pwmLeft);
    analogWrite(ENB, pwmRight);
  }

  // เก็บเวลาตอนแตะเป้าหมายก่อนสั่งหยุด
  runTimeMs = millis() - startMs - accumulatedPauseMs;

  if (cruiseSamples > 0) {
    cruiseSpeedLeft = cruiseSpeedLeftSum / cruiseSamples;
    cruiseSpeedRight = cruiseSpeedRightSum / cruiseSamples;
  }

  // ปล่อยหยุดพร้อมกัน เพราะ dynamic brake ทำให้รถบิดหลังถึงเป้าหมาย
  Stop();
  motionSettled = waitForEncoderStop();

  Serial.println("STOPPED - DO NOT TOUCH ROBOT, MEASURING GYRO...");

  // เก็บ Yaw ระหว่างที่รถกำลังไหลหลังสั่งหยุดด้วย
  unsigned long settleStart = millis();
  while (millis() - settleStart < SETTLE_TIME_MS) {
    updateGyro();
    delay(2);
  }

  readEncoders(finalEncoderL, finalEncoderR);
  finalYaw = yaw;
  finalGyroZ = measureResidualGyroBias();
  Serial.println("MEASUREMENT COMPLETE - ROBOT CAN BE MOVED");
  testFinished = true;
}

void saveFirstStageResult() {
  firstStageResult.ready = true;
  firstStageResult.timedOut = runTimedOut;
  firstStageResult.stateNumber = movementStateNumber;
  firstStageResult.targetDistanceCM = commandedDistanceCM;
  firstStageResult.runTimeMs = runTimeMs;
  firstStageResult.yawAtStop = yawAtStopCommand;
  firstStageResult.leftAtStop = leftAtStopCommand;
  firstStageResult.rightAtStop = rightAtStopCommand;
  firstStageResult.finalLeft = finalEncoderL;
  firstStageResult.finalRight = finalEncoderR;

  float runTimeSec = runTimeMs / 1000.0f;
  if (runTimeSec > 0.0f) {
    firstStageResult.averageSpeedLeft =
      (leftAtStopCommand * CM_PER_TICK) / runTimeSec;
    firstStageResult.averageSpeedRight =
      (rightAtStopCommand * CM_PER_TICK) / runTimeSec;
  }

  firstStageResult.gyroValid = gyroReadFailuresAtStop <= 20
                            && gyroBusRecoveriesAtStop <= 2
                            && gyroInvalidSamplesAtStop <= 5
                            && gyroResidualBiasValid
                            && fabs(finalGyroZ)
                               <= MAX_VALID_RESIDUAL_BIAS;
  firstStageResult.correctedYawAtStop = yawAtStopCommand;
  if (firstStageResult.gyroValid) {
    firstStageResult.correctedYawAtStop -= finalGyroZ
      * (gyroIntegrationTimeMs / 1000.0f);
  }
}

void printFirstStageResult() {
  if (!firstStageResult.ready) return;

  Serial.println("======= SAVED STATE 1 RESULT =======");
  Serial.print("Target Distance      : ");
