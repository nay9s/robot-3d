    // ใช้ค่าตอนสั่งหยุด เพื่อไม่รวมระยะที่ล้อไหลหลังตัดกำลัง
    averageSpeedLeft = (leftAtStopCommand * CM_PER_TICK) / runTimeSec;
    averageSpeedRight = (rightAtStopCommand * CM_PER_TICK) / runTimeSec;
  }

  Serial.println("========== TEST RESULT ==========");
  Serial.print("Firmware             : ");
  Serial.println(FIRMWARE_REVISION);

  Serial.print("Movement State       : ");
  Serial.println(movementStateNumber);

  Serial.print("Target Distance      : ");
  Serial.print(commandedDistanceCM, 1);
  Serial.println(" cm");

  Serial.print("Control Mode         : ");
  Serial.println(USE_GYRO_ASSIST
                 ? "GYRO LEARNING"
                 : "ENCODER-ONLY REPLAY");

  Serial.print("Encoder Counts/Rev   : ");
  Serial.println(ENCODER_COUNTS_PER_REV, 0);

  Serial.print("CM per Count         : ");
  Serial.println(CM_PER_TICK, 3);

  Serial.print("Run time             : ");
  Serial.print(runTimeMs);
  Serial.println(" ms");

  Serial.print("Run Timed Out        : ");
  Serial.println(runTimedOut ? "YES" : "NO");

  Serial.print("Target Cruise Speed  : ");
  Serial.print(commandedSpeed, 2);
  Serial.println(" cm/s");

  Serial.print("First Pulse Left     : ");
  Serial.print(firstLeftTickMs);
  Serial.println(" ms");

  Serial.print("First Pulse Right    : ");
  Serial.print(firstRightTickMs);
  Serial.println(" ms");
  Serial.println("First pulse timing depends on encoder slot phase");

  Serial.print("Cruise Speed Left    : ");
  Serial.print(cruiseSpeedLeft, 2);
  Serial.println(" cm/s");

  Serial.print("Cruise Speed Right   : ");
  Serial.print(cruiseSpeedRight, 2);
  Serial.println(" cm/s");

  Serial.print("Yaw at stop command  : ");
  Serial.print(yawAtStopCommand, 3);
  Serial.println(" deg");

  Serial.print("Final Yaw after stop : ");
  Serial.print(finalYaw, 3);
  Serial.println(" deg");

  Serial.print("Final Gyro Z         : ");
  Serial.print(finalGyroZ, 3);
  Serial.println(" deg/s (residual bias)");

  Serial.print("Gyro Read Failures   : ");
  Serial.println(gyroReadFailures);

  Serial.print("Gyro Retry Successes : ");
  Serial.println(gyroRetrySuccesses);

  Serial.print("Gyro Bus Recoveries  : ");
  Serial.println(gyroBusRecoveries);

  Serial.print("Gyro Invalid Samples : ");
  Serial.println(gyroInvalidSamples);

  Serial.print("Residual Rejected    : ");
  Serial.println(gyroResidualRejectedSamples);

  Serial.print("Failures At Stop     : ");
  Serial.println(gyroReadFailuresAtStop);

  Serial.print("Recoveries At Stop   : ");
  Serial.println(gyroBusRecoveriesAtStop);

  Serial.print("Invalid At Stop      : ");
  Serial.println(gyroInvalidSamplesAtStop);

  Serial.print("Gyro Found At Boot   : ");
  Serial.println(gyroAvailable ? "YES" : "NO");

  Serial.print("Gyro Disabled In Run : ");
  Serial.println(gyroDisabledForRun ? "YES" : "NO");

  Serial.print("Residual Bias Read   : ");
  Serial.println(gyroResidualBiasValid ? "VALID" : "FAILED");

  bool gyroBiasStable = gyroResidualBiasValid
                     && fabs(finalGyroZ) <= MAX_VALID_RESIDUAL_BIAS;
  bool gyroDataReliable = gyroReadFailuresAtStop <= 20
                       && gyroBusRecoveriesAtStop <= 2
                       && gyroInvalidSamplesAtStop <= 5
                       && gyroBiasStable;
  float correctedYawAtStop = yawAtStopCommand
                           - finalGyroZ
                           * (gyroIntegrationTimeMs / 1000.0f);
  float correctedFinalYaw = finalYaw
                          - finalGyroZ
                          * ((gyroIntegrationTimeMs + SETTLE_TIME_MS)
                             / 1000.0f);
  float learningPeakYaw = 0.0f;
  float learningSideOffsetCM = 0.0f;
  float previousLearningYaw = 0.0f;
  for (int i = 0; i < capturedSegmentCount; i++) {
    if (segmentMaxAbsYaw[i] > learningPeakYaw) {
      learningPeakYaw = segmentMaxAbsYaw[i];
    }
    float checkpointYaw = segmentYaw[i]
                        - finalGyroZ * segmentTimeSec[i];
    float averageHeadingDeg =
      (previousLearningYaw + checkpointYaw) * 0.5f;
    float segmentDistanceCM =
      (segmentEncoderL[i] + segmentEncoderR[i])
      * 0.5f * CM_PER_TICK;
    learningSideOffsetCM += segmentDistanceCM
                          * sin(averageHeadingDeg * PI / 180.0f);
    previousLearningYaw = checkpointYaw;
  }
  bool learningMotionComplete = !runTimedOut
                             && !straightStalled && motionSettled
                             && !learningAbortedGyro
                             && !learningAbortedYawLimit
                             && capturedSegmentCount == activeSegmentCount;
  bool learningTrajectoryGood = learningPeakYaw <= MAX_TABLE_PEAK_YAW_DEG
                             && fabs(correctedYawAtStop)
                                <= MAX_TABLE_FINAL_YAW_DEG
                             && fabs(learningSideOffsetCM)
                                <= MAX_TABLE_SIDE_OFFSET_CM;
  bool learningDataUsable = USE_GYRO_ASSIST
                         && learningMotionComplete
                         && gyroDataReliable
                         && learningTrajectoryGood;

  Serial.print("Gyro Bias Status     : ");
  Serial.println(gyroBiasStable ? "STABLE" : "SHIFTED - DO NOT CORRECT YAW");

  Serial.print("Gyro Data Status     : ");
  Serial.println(gyroDataReliable ? "VALID" : "INVALID - DO NOT CALIBRATE");

  if (USE_GYRO_ASSIST) {
    Serial.print("Learning Status      : ");
    if (learningAbortedGyro) {
      Serial.println("ABORTED - GYRO UNSAFE");
    } else if (learningAbortedYawLimit) {
      Serial.println("ABORTED - YAW LIMIT");
    } else if (runTimedOut) {
      Serial.println("ABORTED - TIMEOUT");
    } else if (!learningMotionComplete) {
      Serial.println("INCOMPLETE");
    } else if (!gyroDataReliable) {
      Serial.println("INVALID - DO NOT SAVE TABLE");
    } else if (!learningTrajectoryGood) {
      Serial.println("RETRY - TRAJECTORY OUT OF LIMIT");
    } else {
      Serial.println("COMPLETE - TABLE READY");
    }
    Serial.print("Learning Peak Yaw    : ");
    Serial.print(learningPeakYaw, 3);
    Serial.println(" deg");
    Serial.print("Learning Side Offset : ");
    Serial.print(learningSideOffsetCM, 2);
    Serial.println(" cm");
  }

  if (gyroDataReliable) {
    Serial.print("Corrected Yaw at stop: ");
    Serial.print(correctedYawAtStop, 3);
    Serial.println(" deg");

    Serial.print("Corrected Final Yaw  : ");
    Serial.print(correctedFinalYaw, 3);
    Serial.println(" deg");
  }

  Serial.print("L/R at stop command  : ");
  Serial.print(leftAtStopCommand);
  Serial.print(" / ");
  Serial.println(rightAtStopCommand);

  if (USE_GYRO_ASSIST) {
    Serial.print("Learned R-L at stop : ");
    Serial.print((long)rightAtStopCommand - (long)leftAtStopCommand);
    Serial.println(" ticks (cumulative)");
  }

  Serial.print("Average Speed Left   : ");
  Serial.print(averageSpeedLeft, 2);
  Serial.println(" cm/s");

  Serial.print("Average Speed Right  : ");
  Serial.print(averageSpeedRight, 2);
  Serial.println(" cm/s");

  Serial.print("Encoder settle status: ");
  Serial.println(motionSettled ? "QUIET" : "TIMEOUT");
  Serial.print("Straight stall      : ");
  Serial.println(straightStalled ? "YES" : "NO");
  Serial.print("Final Encoder Left   : ");
  Serial.println(finalEncoderL);

  Serial.print("Final Encoder Right  : ");
  Serial.println(finalEncoderR);

  Serial.print("Distance Left        : ");
  Serial.print(finalEncoderL * CM_PER_TICK, 2);
  Serial.println(" cm");

  Serial.print("Distance Right       : ");
  Serial.print(finalEncoderR * CM_PER_TICK, 2);
  Serial.println(" cm");

  Serial.print("Encoder Diff L-R     : ");
  Serial.println(encoderDiff);

  float finalAverageDistance = (finalEncoderL + finalEncoderR)
                             * 0.5f * CM_PER_TICK;
  Serial.print("Target Diff R-L      : ");
  if (USE_GYRO_ASSIST) {
    Serial.println("LEARNING - NOT USED");
  } else {
    Serial.print(desiredRightExtraTicks(finalAverageDistance), 3);
    Serial.println(" ticks");
    Serial.print("Configured R-L table : { ");
    for (int i = 0; i < activeSegmentCount; i++) {
      Serial.print(encoderTargetForSegment(i), 1);
      if (i < activeSegmentCount - 1) Serial.print(", ");
    }
    Serial.println(" }");
  }

  Serial.println("----- DISTANCE SEGMENT LOG -----");
  if (!gyroDataReliable || capturedSegmentCount == 0) {
    Serial.println("SKIPPED: No reliable Gyroscope checkpoints");
  } else {
    float previousCorrectedYaw = 0.0f;
    float lateralOffsetCM = 0.0f;
    for (int i = 0; i < capturedSegmentCount; i++) {
      float correctedYaw = segmentYaw[i]
                         - finalGyroZ * segmentTimeSec[i];
      float deltaYaw = correctedYaw - previousCorrectedYaw;

      // ประมาณระยะเยื้องข้างจาก heading เฉลี่ยและระยะจริงของช่วงนั้น
      // เครื่องหมายบอกทิศตามเครื่องหมายของ Yaw
      float averageHeadingDeg = (previousCorrectedYaw + correctedYaw) * 0.5f;
      float actualSegmentDistanceCM =
        (segmentEncoderL[i] + segmentEncoderR[i])
        * 0.5f * CM_PER_TICK;
      lateralOffsetCM += actualSegmentDistanceCM
                       * sin(averageHeadingDeg * PI / 180.0f);

      long segmentDiff = (long)segmentEncoderR[i]
                       - (long)segmentEncoderL[i];
      long cumulativeDiff = (long)checkpointEncoderR[i]
                          - (long)checkpointEncoderL[i];

      float averageGyroCorrection = 0.0f;
      float averageGyroSpeedCorrection = 0.0f;
      float averageLearningBalancePWM = 0.0f;
      if (segmentGyroCorrectionSamples[i] > 0) {
        averageGyroCorrection = segmentGyroCorrectionSum[i]
                              / segmentGyroCorrectionSamples[i];
        averageGyroSpeedCorrection = segmentGyroSpeedCorrectionSum[i]
                                   / segmentGyroCorrectionSamples[i];
        averageLearningBalancePWM = segmentLearningBalancePWMSum[i]
                                  / segmentGyroCorrectionSamples[i];
      }

      // การชดเชยเชิงเรขาคณิต: R-L = trackWidth * yaw(rad)
      // รายงานต่อความกว้างฐานล้อ 1 cm ก่อน เพื่อไม่เดาขนาดตัวรถ
      float correctionTicksPerTrackCM =
        (correctedYaw * PI / 180.0f) / CM_PER_TICK;

      Serial.print("Segment ");
      Serial.print(i + 1);
      Serial.print(" | Checkpoint: ");
      float checkpointCM = min(commandedDistanceCM,
                               (i + 1) * CALIBRATION_SEGMENT_CM);
      Serial.print(checkpointCM, 1);
      Serial.print(" cm | Segment distance: ");
      Serial.print(actualSegmentDistanceCM, 1);
      Serial.print(" cm");
      Serial.print(" | From start: ");
      Serial.print(correctedYaw, 3);
      Serial.print(" deg | This segment: ");
      Serial.print(deltaYaw, 3);
      Serial.print(" deg | Max abs yaw: ");
      Serial.print(segmentMaxAbsYaw[i], 3);
      Serial.print(" deg | End gyro Z: ");
      Serial.print(segmentGyroRateAtCheckpoint[i], 3);
      Serial.print(" deg/s | Side offset: ");
      Serial.print(lateralOffsetCM, 2);
      Serial.print(" cm | Segment R-L: ");
      Serial.print(segmentDiff);
      Serial.print(" ticks | Cumulative R-L: ");
      Serial.print(cumulativeDiff);
      Serial.print(" ticks | Avg gyro speed +/-: ");
      Serial.print(averageGyroSpeedCorrection, 3);
      Serial.print(" cm/s | Avg balance PWM/side: ");
      Serial.print(averageLearningBalancePWM, 1);
      Serial.print(" | Avg total diff PWM/side: ");
      Serial.print(averageGyroCorrection, 1);
      Serial.print(" | Need R-L per track-cm: ");
      Serial.print(correctionTicksPerTrackCM, 5);
      Serial.println(" ticks");

      previousCorrectedYaw = correctedYaw;
    }

    if (learningDataUsable) {
      Serial.println("----- ENCODER-ONLY REPLAY TABLE -----");
      Serial.print("const float LEARNED_R_MINUS_L[");
      Serial.print(activeSegmentCount);
      Serial.print("] = { ");
      for (int i = 0; i < activeSegmentCount; i++) {
        long learnedDiff = (long)checkpointEncoderR[i]
                         - (long)checkpointEncoderL[i];
        Serial.print((float)learnedDiff, 1);
        if (i < activeSegmentCount - 1) Serial.print(", ");
      }
      Serial.println(" };");
      Serial.println("Use this cumulative R-L table for replay; keep PWM trim at zero");
    } else if (USE_GYRO_ASSIST) {
      Serial.println("LEARNED TABLE SKIPPED: Check Learning Status above");
    }
  }
  Serial.println("=================================");
}

// =====================================================
// COMBINED SETUP / LOOP
// =====================================================
const float SHORT_PATH_DISTANCE_CM = 400.0f;
const float LONG_RANGE_DISTANCE_CM = 500.0f;
const float COMBINED_FORWARD_SPEED_CM_S = 50.0f;
const float FINAL_LEFT_TURN_DEG = ROTATE_TARGET_DEG;
const int FINAL_LEFT_TURN_DIRECTION = -1;
const unsigned long COMBINED_STATE_PAUSE_MS = 500UL;
const int COMBINED_STATE_COUNT = 4;
// 0 = existing full sequence; 1 = one forward test; 2 = right turn; 3 = left turn.
// Start field validation with mode 1, then 2/3. This firmware does not implement reverse.
const int ENCODER_TEST_MODE = 0;
const float ENCODER_TEST_DISTANCE_CM = 100.0f;
const float ENCODER_TEST_SPEED_CM_S = 25.0f;
const float ENCODER_TEST_TURN_DEG = 90.0f;

void initializeCombinedHardware() {
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(ENC_R, INPUT);
  pinMode(ENC_L, INPUT);

  analogWriteResolution(12);

  attachInterrupt(digitalPinToInterrupt(ENC_R), ISR_encoderR, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENC_L), ISR_encoderL, CHANGE);

  Stop();

  // ใช้ Encoder อย่างเดียว: ไม่เริ่มต้นและไม่อ่าน MPU6050
  gyroAvailable = false;
  gyroDisabledForRun = true;
}

bool runCombinedForwardState(int stateNumber,
                             const char *stateName,
                             float distanceCM,
                             ForwardProfile profile) {
  movementStateNumber = stateNumber;
  activeForwardProfile = profile;
  Serial.println();
  Serial.print("CURRENT STATE ");
  Serial.print(stateNumber);
  Serial.print("/");
  Serial.print(COMBINED_STATE_COUNT);
  Serial.print(": ");
  Serial.print(stateName);
  Serial.print(" | target ");
  Serial.print(distanceCM, 1);
  Serial.print(" cm = ");
  Serial.print(distanceCM / 100.0f, 2);
  Serial.println(" m");

  motionSettled = true;
  forwardClosedLoop(COMBINED_FORWARD_SPEED_CM_S, distanceCM);
  printResult();
  if (runTimedOut || straightStalled || !motionSettled || learningAbortedGyro || learningAbortedYawLimit) {
    Stop();
    Serial.println("STATE FAILED - ROUTE ABORTED");
    return false;
  }

  Serial.print("STATE ");
  Serial.print(stateNumber);
  Serial.print("/");
  Serial.print(COMBINED_STATE_COUNT);
  Serial.println(" COMPLETE");
  return true;
}

bool runCombinedRotationState(int stateNumber,
                              const char *stateName,
                              float targetDeg,
                              int direction) {
  movementStateNumber = stateNumber;
  Serial.println();
  Serial.print("CURRENT STATE ");
  Serial.print(stateNumber);
  Serial.print("/");
  Serial.print(COMBINED_STATE_COUNT);
  Serial.print(": ");
  Serial.print(stateName);
  Serial.print(" | target ");
  Serial.print(targetDeg, 1);
  Serial.print(" deg | direction ");
  Serial.println(direction > 0 ? "RIGHT" : "LEFT");

  motionSettled = true;
  if (ROTATE_USE_GYRO_LEARNING) {
    rotateGyroMeasureEncoder(targetDeg, direction);
  } else {
    rotateEncoderReplay(targetDeg, direction);
  }
  printRotationResult();
  if (runTimedOut || !motionSettled || rotationAbortedGyro || rotationAbortedWrongDirection
      || rotationAbortedWheelStart || rotationAbortedWheelMismatch) {
    Stop();
    Serial.println("STATE FAILED - ROUTE ABORTED");
    return false;
  }
  Serial.print("STATE ");
  Serial.print(stateNumber);
  Serial.print("/");
  Serial.print(COMBINED_STATE_COUNT);
  Serial.println(" COMPLETE");
  return true;
}

void pauseBeforeNextState(int completedState) {
  Stop();
  Serial.print("PAUSE AFTER STATE ");
  Serial.print(completedState);
  Serial.println(": 0.5 SECOND BEFORE NEXT STATE");
  delay(COMBINED_STATE_PAUSE_MS);
}

void printCombinedStatePlan() {
  Serial.println("STATE PLAN (distance unit: cm and m)");
  Serial.print("  FORWARD SPEED: ");
  Serial.print(COMBINED_FORWARD_SPEED_CM_S, 1);
  Serial.println(" cm/s");
  Serial.print("  STATE 1/4: shortpathgood | ");
  Serial.print(SHORT_PATH_DISTANCE_CM, 1);
  Serial.print(" cm = ");
  Serial.print(SHORT_PATH_DISTANCE_CM / 100.0f, 2);
  Serial.println(" m");
  Serial.print("  STATE 2/4: turnright360good | ");
  Serial.print(ROTATE_TARGET_DEG, 1);
  Serial.print(" deg | ");
  Serial.println(ROTATE_DIRECTION > 0 ? "RIGHT" : "LEFT");
  Serial.print("  STATE 3/4: longrangegood | ");
  Serial.print(LONG_RANGE_DISTANCE_CM, 1);
  Serial.print(" cm = ");
  Serial.print(LONG_RANGE_DISTANCE_CM / 100.0f, 2);
  Serial.println(" m");
  Serial.print("  STATE 4/4: final left turn | ");
  Serial.print(FINAL_LEFT_TURN_DEG, 1);
  Serial.println(" deg | LEFT");
}

void setup() {
  Serial.begin(115200);
  Serial.print("FIRMWARE: ");
  Serial.println(FIRMWARE_REVISION);
  Serial.println("PROFILE CHANGED: REVALIDATE CALIBRATION BEFORE FULL ROUTE");
  printCombinedStatePlan();

  initializeCombinedHardware();

  if (ENCODER_TEST_MODE != 0) {
    if (ENCODER_TEST_MODE == 1) {
      activeForwardProfile = SHORT_PATH_PROFILE;
      forwardClosedLoop(ENCODER_TEST_SPEED_CM_S, ENCODER_TEST_DISTANCE_CM);
      printResult();
      Serial.println((runTimedOut || straightStalled || !motionSettled)
        ? "SINGLE TEST FAILED" : "SINGLE TEST COMPLETE");
    } else if (ENCODER_TEST_MODE == 2 || ENCODER_TEST_MODE == 3) {
      runCombinedRotationState(1, "single encoder turn", ENCODER_TEST_TURN_DEG,
                               ENCODER_TEST_MODE == 2 ? 1 : -1);
    } else Serial.println("INVALID TEST MODE");
    Stop();
    return;
  }

  if (!runCombinedForwardState(1,
                          "shortpathgood",
                          SHORT_PATH_DISTANCE_CM,
                          SHORT_PATH_PROFILE)) return;
  pauseBeforeNextState(1);

  if (!runCombinedRotationState(2,
                           "turnright360good",
                           ROTATE_TARGET_DEG,
                           ROTATE_DIRECTION)) return;
  pauseBeforeNextState(2);

  if (!runCombinedForwardState(3,
                          "longrangegood",
                          LONG_RANGE_DISTANCE_CM,
                          LONG_RANGE_PROFILE)) return;
  pauseBeforeNextState(3);

  if (!runCombinedRotationState(4,
                           "final left turn",
                           FINAL_LEFT_TURN_DEG,
                           FINAL_LEFT_TURN_DIRECTION)) return;
  Serial.println("ALL COMBINED STATES COMPLETE");
}

void loop() {
  // All movement states are executed once from setup().
  if (testFinished) {
    delay(1000);
  }
}
